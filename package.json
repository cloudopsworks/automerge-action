{
  "name": "automerge-action",
  "version": "0.17.0",
  "description": "GitHub action to automatically merge pull requests",
  "type": "module",
  "main": "lib/api.js",
  "author": "Pascal",
  "license": "MIT",
  "private": true,
  "bin": {
    "automerge-action": "./bin/automerge.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "it": "node it/it.js",
    "lint": "prettier -l lib/** test/** && eslint .",
    "compile": "ncc build bin/automerge.js --license LICENSE -o dist",
    "prepublish": "yarn lint && yarn test && yarn compile"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/rest": "^22.0.1",
    "argparse": "^3.0.0",
    "fs-extra": "^11.4.0",
    "lodash-es": "^4.18.1",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.44.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-jest": "^29.16.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6"
  },
  "prettier": {
    "trailingComma": "none",
    "arrowParens": "avoid"
  }
}
